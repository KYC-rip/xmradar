<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Opt-in runtime permission on Android 13+ for XMRadar (Xaps, xos) and X / Chat PWA notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 11+ package visibility for external NIP-55 Nostr signer apps (e.g. Amber). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="nostrsigner" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="nostrsigner" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.XMRadar"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|mcc|mnc|orientation|screenSize|locale|layoutDirection|smallestScreenSize|screenLayout|uiMode|density|fontScale|fontWeightAdjustment|grammaticalGender|navigation|touchscreen|colorMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Share sheet: "Open in XMRadar" for a post link. MainActivity validates text/plain,
                 accepts only x.com / twitter.com URLs, and ignores everything else. -->
            <intent-filter android:label="@string/open_in_xmradar">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- Explicit "Open with XMRadar" for X web links. Android 12+ only routes taps here
                 automatically with verified App Links, which x.com cannot do for us, so this mainly
                 serves explicit chooser picks, adb, and launchers. The share target above is the
                 reliable path; the xmradar:// scheme below is for apps that construct links. -->
            <intent-filter android:label="@string/open_in_xmradar">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="x.com" />
                <data android:scheme="https" android:host="www.x.com" />
                <data android:scheme="https" android:host="mobile.x.com" />
                <data android:scheme="https" android:host="twitter.com" />
                <data android:scheme="https" android:host="www.twitter.com" />
                <data android:scheme="https" android:host="mobile.twitter.com" />
                <data android:scheme="https" android:host="m.twitter.com" />
            </intent-filter>

            <!-- xmradar://open?url=<percent-encoded https X URL> -->
            <intent-filter android:label="@string/open_in_xmradar">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="xmradar" android:host="open" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".NotificationDismissReceiver"
            android:exported="false" />
    </application>
</manifest>
