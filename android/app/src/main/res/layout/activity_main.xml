<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <org.mozilla.geckoview.GeckoView
        android:id="@+id/gecko_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_gravity="top"
        android:indeterminate="false"
        android:max="100"
        android:progressTint="@color/accent"
        android:visibility="gone" />

    <!-- Draggable, edge-snapping floating XMRadar orb (no double bottom bar over X's own tab bar). -->
    <FrameLayout
        android:id="@+id/fab_container"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="12dp"
        android:clickable="true"
        android:contentDescription="@string/nav_xmradar"
        android:elevation="8dp"
        android:focusable="true">

        <FrameLayout
            android:id="@+id/fab_orb"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center">

            <ImageView
                android:id="@+id/fab_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:alpha="0.92"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_xmradar" />
        </FrameLayout>

        <TextView
            android:id="@+id/fab_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_fab_badge"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>
</FrameLayout>
